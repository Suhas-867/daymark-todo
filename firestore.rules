rules_version = '2';

// Daymark security rules for the free Firebase plan (Firestore + Auth only, no Cloud Functions).
//
// BEFORE PUBLISHING: replace REPLACE_WITH_ADMIN_EMAIL below with the administrator's email address, in
// lower case. The address is only ever stored in your Firebase project, not in the app code.
//
// What these rules guarantee: members can only read and write their own data; only the verified
// administrator can read other members' proofs and make manual decisions; deadlines, timer lengths and
// the 10 free tasks are checked. What they cannot guarantee without server code: a member who edits the
// app in their own browser could still change their own score. Tamper-proof scoring needs Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    function adminEmail() { return 'REPLACE_WITH_ADMIN_EMAIL'; }
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == adminEmail(); }
    function nowMs() { return request.time.toMillis(); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.trialTasksUsed == 0
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'emailReminders', 'smsReminders', 'consentUpdatedAt', 'emailVerified', 'emailCode', 'trialTasksUsed', 'activeSessionId', 'createdAt', 'reminderDay', 'reminderEmails']);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'emailReminders', 'smsReminders', 'consentUpdatedAt', 'emailVerified', 'emailCode', 'trialTasksUsed', 'activeSessionId', 'reminderDay', 'reminderEmails'])
        && (request.resource.data.trialTasksUsed == resource.data.trialTasksUsed || request.resource.data.trialTasksUsed == resource.data.trialTasksUsed + 1);
      allow delete: if false;

      // One document per page visit: points, rewards and the demo membership reset on refresh.
      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && request.resource.data.points == 0;
        allow update: if isAdmin() || (isOwner(uid) && request.resource.data.points <= resource.data.points + 100);
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
          && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes >= 1 && request.resource.data.durationMinutes <= 1440
          && request.resource.data.deadlineAt == request.resource.data.createdAt + request.resource.data.durationMinutes * 60000
          && request.resource.data.createdAt <= nowMs() + 600000 && request.resource.data.createdAt >= nowMs() - 600000;
        allow update: if isAdmin()
          || (isOwner(uid)
              && request.resource.data.title == resource.data.title
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.deadlineAt == resource.data.deadlineAt
              && request.resource.data.durationMinutes == resource.data.durationMinutes
              && request.resource.data.get('reviewer', '') != 'admin');
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Review queue entries (small metadata) and the proof photos (one document each, read on demand).
    match /reviewQueue/{proofId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.uid == resource.data.uid
            && (request.resource.data.status == 'pending' || request.resource.data.reviewer == 'ai'));
      allow delete: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
    }
    match /proofImages/{proofId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
    }

    // Reminder log shown in the admin console.
    match /outbox/{entryId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
