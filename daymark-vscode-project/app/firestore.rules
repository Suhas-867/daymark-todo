rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name','email','phone','emailReminders','smsReminders','createdAt','preferencesUpdatedAt','trialTasksUsed'])
        && (!('trialTasksUsed' in request.resource.data) || request.resource.data.trialTasksUsed == resource.data.trialTasksUsed);
      allow delete: if false;
      match /sessions/{sessionId} { allow read: if owner(uid); allow write: if false; }
      match /tasks/{taskId} { allow read: if owner(uid); allow write: if false; }
    }
    match /reviewQueue/{proofId} { allow read: if admin(); allow write: if false; }
  }
}
